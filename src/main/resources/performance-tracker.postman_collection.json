{
  "info": {
    "name": "Performance Tracker API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Employee",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "http://localhost:8080/employees",
        "body": { "mode": "raw", "raw": "{\n    \"name\": \"Dan Lee\",\n    \"department\": \"Engineering\",\n    \"role\": \"DevOps Engineer\",\n    \"joiningDate\": \"2024-01-15\"\n}" }
      }
    },
    {
      "name": "Submit Review",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "http://localhost:8080/reviews",
        "body": { "mode": "raw", "raw": "{\n    \"employeeId\": 1,\n    \"cycleId\": 1,\n    \"rating\": 5,\n    \"reviewerNotes\": \"Outstanding leadership this quarter\"\n}" }
      }
    },
    {
      "name": "Get Employee Reviews",
      "request": {
        "method": "GET",
        "url": "http://localhost:8080/employees/1/reviews"
      }
    },
    {
      "name": "Get Cycle Summary",
      "request": {
        "method": "GET",
        "url": "http://localhost:8080/cycles/1/summary"
      }
    },
    {
      "name": "Filter Employees",
      "request": {
        "method": "GET",
        "url": "http://localhost:8080/employees?department=Engineering&minRating=3.5"
      }
    }
  ]
}